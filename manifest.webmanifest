{
  "name": "Universal CAD Studio v0.29.2",
  "short_name": "Universal CAD",
  "description": "Offline-first CAD and NPI preparation workspace for board data, mapping, validation, revision comparison, package analysis, BOM, and multi-format export.",
  "start_url": "./",
